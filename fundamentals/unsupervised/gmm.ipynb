   "source": [
    "# Import Libraries \n",
    "from sklearn import datasets, mixture \n",
    "\n",
    "X = datasets.load_iris().data\n",
    "\n",
    "gmm = mixture.GaussianMixture(n_components=3)\n",
    "gmm.fit(X)\n",
    "clustering = gmm.predict(X)\n",
    "\n",
    "clustering"
   ]
